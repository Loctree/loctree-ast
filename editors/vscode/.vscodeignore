# The extension is bundled by esbuild (main = ./dist/extension.js, which inlines
# vscode-languageclient and the rest of the dependency tree). The runtime needs
# only dist/extension.js + bin/ + media/, so node_modules and sources are
# excluded wholesale — this is also what removes the "Cannot find module" class
# of activation failures the unbundled package had.
