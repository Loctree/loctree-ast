<!--
  Loctree-specific extension and action registrations.

  This file is the append-only merge target for parallel feature
  slices. Add new extensions/actions at the end of the matching group
  rather than rewriting existing entries to avoid worker collisions.

  𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. with AI Agents ⓒ 2025-2026 Vetcoders
-->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Settings: persistent application-level state + UI. -->
        <applicationService
                serviceImplementation="io.loct.intellij.settings.LoctreeSettingsState"/>
        <applicationConfigurable
                parentId="tools"
                instance="io.loct.intellij.settings.LoctreeSettingsConfigurable"
                id="io.loct.intellij.settings.LoctreeSettingsConfigurable"
                key="settings.display.name"
                bundle="messages.LoctreeBundle"/>

        <!-- Status bar widget reflecting Context-King runtime state. -->
        <statusBarWidgetFactory
                id="io.loct.intellij.statusbar.LoctreeStatusBarWidget"
                implementation="io.loct.intellij.statusbar.LoctreeStatusBarWidgetFactory"
                order="last"/>

        <!-- Context-King tool window with secondary findings signal. -->
        <toolWindow
                id="Loctree"
                anchor="right"
                icon="/icons/loctree-action.svg"
                factoryClass="io.loct.intellij.toolwindow.LoctreeToolWindowFactory"/>

        <!-- Project-open startup: the tool window and custom requests need LSP before file-open events. -->
        <postStartupActivity
                implementation="io.loct.intellij.lsp.LoctreeLspStartupActivity"/>

        <!-- Notifications. -->
        <notificationGroup
                id="Loctree"
                displayType="BALLOON"
                key="notification.group.name"
                bundle="messages.LoctreeBundle"/>
    </extensions>

    <!-- Native LSP server support provider (Ultimate API). -->
    <extensions defaultExtensionNs="com.intellij.platform">
        <lsp.serverSupportProvider
                implementation="io.loct.intellij.lsp.LoctreeLspServerSupportProvider"/>
    </extensions>

    <actions>
        <group id="io.loct.intellij.actions.LoctreeGroup"
               text="Loctree"
               icon="/icons/loctree-action.svg"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>

            <action id="io.loct.intellij.actions.RefreshAction"
                    class="io.loct.intellij.actions.RefreshAction"
                    icon="AllIcons.Actions.Refresh"/>
            <action id="io.loct.intellij.actions.ShowHealthAction"
                    class="io.loct.intellij.actions.ShowHealthAction"/>
            <!-- Menu actions (long IDs for Editor/Project popups). -->
            <action id="io.loct.intellij.actions.AnalyzeImpactAction"
                    class="io.loct.intellij.actions.AnalyzeImpactAction"/>
            <action id="io.loct.intellij.actions.ShowSliceAction"
                    class="io.loct.intellij.actions.ShowSliceAction"/>
            <action id="io.loct.intellij.actions.FindConsumersAction"
                    class="io.loct.intellij.actions.FindConsumersAction"/>
            <action id="io.loct.intellij.actions.FindImportersAction"
                    class="io.loct.intellij.actions.FindImportersAction"/>
            <action id="io.loct.intellij.actions.CheckDeadExportsAction"
                    class="io.loct.intellij.actions.CheckDeadExportsAction"/>
            <action id="io.loct.intellij.actions.ShowCyclesAction"
                    class="io.loct.intellij.actions.ShowCyclesAction"/>
            <action id="io.loct.intellij.actions.AnalyzeCycleAction"
                    class="io.loct.intellij.actions.AnalyzeCycleAction"/>

            <action id="io.loct.intellij.actions.OpenReportAction"
                    class="io.loct.intellij.actions.OpenReportAction"/>
            <action id="io.loct.intellij.actions.FindLiteralOccurrencesAction"
                    class="io.loct.intellij.actions.FindLiteralOccurrencesAction"/>
        </group>

        <!-- LSP CodeAction command IDs are protocol adapters, not duplicate popup
             entries. Keep them registered outside LoctreeGroup and give every
             action a non-empty default text for IntelliJ action-system safety.
             IDs must match loctree-lsp refactor.rs + quickfix.rs and the VS Code
             command surface. Guard: ContributedLspCommandsTest. -->
        <action id="loctree.analyzeImpact"
                class="io.loct.intellij.actions.LspAnalyzeImpactAction"
                text="Analyze Change Impact"/>
        <action id="loctree.findImporters"
                class="io.loct.intellij.actions.LspFindImportersAction"
                text="Find Importers"/>
        <action id="loctree.findConsumers"
                class="io.loct.intellij.actions.LspFindConsumersAction"
                text="Find Consumers"/>
        <action id="loctree.analyzeCycle"
                class="io.loct.intellij.actions.LspAnalyzeCycleAction"
                text="Analyze Cycle Breaking Options"/>
        <action id="loctree.openReport"
                class="io.loct.intellij.actions.LspOpenReportAction"
                text="Open HTML Report"/>
        <action id="loctree.checkDeadExports"
                class="io.loct.intellij.actions.LspCheckDeadExportsAction"
                text="Check Dead Exports"/>
        <action id="loctree.showCycles"
                class="io.loct.intellij.actions.LspShowCyclesAction"
                text="Show Circular Imports"/>
        <action id="loctree.showCycleDetails"
                class="io.loct.intellij.actions.LspShowCycleDetailsAction"
                text="Show Cycle Details"/>
        <action id="loctree.navigateToFile"
                class="io.loct.intellij.actions.LspNavigateToFileAction"
                text="Navigate to File"/>
        <action id="loctree.ignoreCycle"
                class="io.loct.intellij.actions.LspIgnoreCycleAction"
                text="Ignore Cycle"/>
    </actions>
</idea-plugin>
